[Unit]
Description=Private read-only DeepSeek Harness Web observer
After=network-online.target tailscaled.service csbot-ai-observer-sync.service
Wants=network-online.target csbot-ai-observer-sync.service

[Service]
DynamicUser=true
StateDirectory=csbot-ai-observer
WorkingDirectory=/var/lib/csbot-ai-observer
Environment=DSH_HOME=/var/lib/csbot-ai-observer/harness
Environment=CSBOT_DSH_SESSIONS=/var/lib/csbot-ai-observer/sessions
Environment=CSBOT_DSH_WEB_HOST=100.101.30.74
Environment=CSBOT_DSH_WEB_PORT=3088
Environment=PATH=/opt/csbot-node/bin:/usr/bin:/bin
Environment=NODE_OPTIONS=--max-old-space-size=256
BindReadOnlyPaths=/home/ubuntu/csbot/ai_runtime/dsh:/opt/csbot-dsh
BindReadOnlyPaths=/home/ubuntu/csbot/.tools/node:/opt/csbot-node
BindReadOnlyPaths=/home/ubuntu/csbot/data/ai-observer/sessions:/var/lib/csbot-ai-observer/sessions
ExecStart=/opt/csbot-node/bin/node /opt/csbot-dsh/observer-launch.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=64
CPUQuota=50%

[Install]
WantedBy=multi-user.target
