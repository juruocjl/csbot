# GCP direct egress profile.
#
# The US host reaches OpenAI and DeepSeek directly, so every cross-border
# loopback proxy that the previous deployment required must be disabled here.
# This file is loaded with `EnvironmentFile=` AFTER `.env.prod`, which is how a
# stale `http://127.0.0.1:7890` inherited from the old server is overridden
# without editing the secret-bearing env file.
CSBOT_DIRECT_EGRESS=1
CS_AI_OPENAI_PROXY_URL=direct
CS_AI_FETCH_PROXY_URL=
